{
  "name": "Neon Bay",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "A chrome-and-neon ring over a sunset bay: every item is a smoked-glass panel cut to its slot, the hovered one lighting up in pink neon.",
  "engineVersion": 2,
  "maxMenuRadius": 204,
  "centerTextWrapWidth": 80,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "radial-gradient(circle at 50% 30%, #3a1d52, #0c0716 72%)",
  "presets": ["Teal Night", "Ultraviolet"],
  "colors": {
    "accent-color": "#ff4fd8",
    "neon-1": "#ff7ae0",
    "neon-2": "#5ee7ff",
    "neon-3": "#ffb36b",
    "neon-hot": "#fff0fb",
    "text-color": "#ffe8fb"
  },
  "layers": [
    { "class": "face", "content": "icon" },
    { "class": "plate", "content": "none" },
    { "class": "shade", "content": "none" }
  ],
  "slices": {
    "inner": 64,
    "outer": 128,
    "tile": "slice.webp",
    "tileHover": "slice-hover.webp",
    "tileSpan": 45,
    "tileFrame": 400,
    "lift": 1,
    "glow": "accent-color",
    "ringSpacing": 9.6
  }
}
