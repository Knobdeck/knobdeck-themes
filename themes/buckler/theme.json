{
  "name": "Buckler",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "A round plank shield: iron rim and studs, an iron boss in the middle, badges nailed to the wood, and a lean towards your pointer.",
  "engineVersion": 1,
  "maxMenuRadius": 175,
  "centerTextWrapWidth": 76,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "radial-gradient(circle at 50% 35%, #3a3026, #0f0c09 72%)",
  "presets": [
    "Raider",
    "Royal",
    "Forest",
    "Blackiron"
  ],
  "colors": {
    "accent-color": "#ffb23f",
    "accent-ink": "#2a1700",
    "icon-color": "#f3e6d0",
    "boss-icon-color": "#f7efe2",
    "text-color": "#f7efe2",
    "wood-1": "#7a4f2a",
    "wood-2": "#9a6838",
    "wood-3": "#6a4222",
    "paint": "linear-gradient(transparent, transparent)",
    "iron-light": "#8c9196",
    "iron-mid": "#4b5055",
    "iron-dark": "#1f2225",
    "badge-light": "#5a4330",
    "badge-dark": "#2c1f15"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    },
    {
      "class": "studs",
      "content": "none"
    },
    {
      "class": "plate",
      "content": "none"
    },
    {
      "class": "shade",
      "content": "none"
    }
  ]
