{
  "name": "Vinyl",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "The menu is a record: grooves that light under the item you point at, light sliding over them and a paper label spinning at 33 rpm.",
  "engineVersion": 1,
  "maxMenuRadius": 175,
  "centerTextWrapWidth": 70,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "radial-gradient(circle at 50% 30%, #2c2a33, #0c0b0f 70%)",
  "presets": [
    "Blue Pressing",
    "Gold Record",
    "Mint"
  ],
  "colors": {
    "accent-color": "#ff5a4f",
    "icon-color": "#ececec",
    "text-color": "#1b0d0d",
    "vinyl-color": "#0d0d0f",
    "vinyl-light": "#1c1c20",
    "vinyl-groove": "rgba(255, 255, 255, 0.045)",
    "label-color": "#ff5a4f",
    "label-ink": "#24100e"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    },
    {
      "class": "label",
      "content": "none"
    },
    {
      "class": "sheen",
      "content": "none"
    },
    {
      "class": "plate",
      "content": "none"
    },
    {
      "class": "shade",
      "content": "none"
    }
  ]
}
