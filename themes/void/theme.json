{
  "name": "Void",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.3.0",
  "description": "Pure black: black slices on a black disc, drawn only in hairlines and light, and every move on a spring — folders pour out of the centre.",
  "engineVersion": 2,
  "maxMenuRadius": 170,
  "centerTextWrapWidth": 76,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "#000",
  "presets": [
    "Ice",
    "Ember",
    "Violet"
  ],
  "colors": {
    "accent-color": "#ffffff",
    "icon-color": "rgba(255, 255, 255, 0.78)",
    "icon-hot": "#ffffff",
    "text-color": "#ffffff",
    "icon-ink": "#c7c7c7"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    },
    {
      "class": "plate",
      "content": "none"
    },
    {
      "class": "shade",
      "content": "none"
    }
  ],
  "slices": {
    "inner": 64,
    "outer": 128,
    "gap": 3,
    "corner": 6,
    "bevel": 1.4,
    "height": 0.6,
    "border": 1.6,
    "field": 0.05,
    "lift": 0,
    "maps": {
      "albedo": "slice-albedo.webp",
      "normal": "slice-normal.webp",
      "rough": "slice-rough.webp"
    },
    "mapSpan": 272,
    "brightness": 1,
    "light": [
      -0.12,
      0.3,
      0.95
    ],
    "glow": "accent-color",
    "ringSpacing": 9.6
  }
}
