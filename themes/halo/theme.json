{
  "name": "Halo",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.2.0",
  "description": "A quiet dark platter with a watch-face scale: gray slices, crisp edges, and a blue pointer that turns to the item you point at.",
  "engineVersion": 2,
  "maxMenuRadius": 170,
  "centerTextWrapWidth": 76,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "radial-gradient(circle at 50% 30%, #3a3a3e, #121214 75%)",
  "presets": [
    "Graphite",
    "Orange",
    "Pink",
    "Green"
  ],
  "colors": {
    "accent-color": "#0a84ff",
    "plate-color": "#1c1c1e",
    "center-color": "#2a2a2d",
    "icon-color": "#e5e5ea",
    "icon-hot": "#ffffff",
    "text-color": "#f2f2f7",
    "tick-color": "rgba(235, 235, 245, 0.30)"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    },
    {
      "class": "plate",
      "content": "none"
    },
    {
      "class": "shade",
      "content": "none"
    }
  ],
  "slices": {
    "inner": 64,
    "outer": 128,
    "gap": 4,
    "corner": 7,
    "bevel": 1.6,
    "height": 0.8,
    "border": 1.6,
    "field": 0.05,
    "lift": 0,
    "maps": {
      "albedo": "slice-albedo.webp",
      "normal": "slice-normal.webp",
      "rough": "slice-rough.webp"
    },
    "mapSpan": 272,
    "brightness": 1,
    "light": [
      -0.12,
      0.3,
      0.95
    ],
    "glow": "accent-color",
    "ringSpacing": 9.6
  }
}
