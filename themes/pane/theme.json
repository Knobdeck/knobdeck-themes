{
  "name": "Pane",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "A layered dark surface with small-radius tiles and hairline strokes; the item you point at gets an accent pill.",
  "engineVersion": 2,
  "maxMenuRadius": 170,
  "centerTextWrapWidth": 76,
  "sliderStyle": "track",
  "drawChildrenBelow": false,
  "drawCenterText": true,
  "drawSelectionWedges": false,
  "drawWedgeSeparators": false,
  "previewBackground": "radial-gradient(circle at 50% 30%, #2f3a48, #101418 75%)",
  "presets": [
    "Orange",
    "Purple",
    "Green"
  ],
  "colors": {
    "accent-color": "#60cdff",
    "plate-color": "#202020",
    "center-color": "#2b2b2b",
    "icon-color": "#ffffff",
    "icon-hot": "#ffffff",
    "text-color": "#ffffff"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    },
    {
      "class": "plate",
      "content": "none"
    },
    {
      "class": "shade",
      "content": "none"
    }
  ],
  "slices": {
    "inner": 64,
    "outer": 128,
    "gap": 3,
    "corner": 4,
    "bevel": 1.2,
    "height": 0.6,
    "border": 1.6,
    "field": 0.05,
    "lift": 0,
    "maps": {
      "albedo": "slice-albedo.webp",
      "normal": "slice-normal.webp",
      "rough": "slice-rough.webp"
    },
    "mapSpan": 272,
    "brightness": 1,
    "light": [
      -0.12,
      0.3,
      0.95
    ],
    "glow": "accent-color",
    "ringSpacing": 9.6
  }
}
